# backend/.env の見本。コピーして値を設定する(.env は Git 管理対象外)
# Azure 上では同じ名前をアプリ設定(環境変数)に登録する

# local / azure(azure ではセッション Cookie を HTTPS のみで送信する)
APP_ENV=local
# セッション Cookie の署名鍵。本番では十分に長いランダム文字列にする
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me
APP_SESSION_MAX_AGE_DAYS=14

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ai_learning_portal
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=ai_learning_portal
# Azure Database for MySQL(TLS 必須)では CA 証明書を指定する
#   コンテナでは /etc/ssl/certs/ca-certificates.crt を指定すればよい
MYSQL_SSL_CA=

# 講座の画像の保存先(local: ローカルのフォルダ。既定は backend/var/images)
# Azure では Blob Storage を使う予定(docs/azure_deploy.md の「講座の画像の保存先」)
IMAGE_STORE=local
# IMAGE_LOCAL_DIR=

# ブラウザ内 Python(Pyodide)の配信元。自前配信に切り替える場合は URL(末尾 /)を変更する
PYODIDE_BASE_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/

# AI(Azure OpenAI。010_ai_reviewer と同じ)。ローカルではリポジトリ直下の .env の値が使われる
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
AI_MODEL_OUTLINE=gpt-6-luna
AI_MODEL_DRAFT=gpt-6-luna
AI_TIMEOUT_SECONDS=300
# AI が作ったコードをサーバで実行して確かめる(Node.js + Pyodide。backend/runner で npm install が必要)
AI_RUNNER_ENABLED=true
AI_RUNNER_NODE=node
AI_RUNNER_TIMEOUT_SECONDS=600

# DB の自動起動・停止(Azure 上でのみ true にする。docs/azure_deploy.md 参照)
DB_AUTOSTART_ENABLED=false
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
MYSQL_SERVER_NAME=
DB_IDLE_STOP_MINUTES=60
