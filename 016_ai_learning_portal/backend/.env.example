# backend/.env の見本。コピーして値を設定する(.env は Git 管理対象外)
# Azure 上では同じ名前をアプリ設定(環境変数)に登録する

# local / azure(azure ではセッション Cookie を HTTPS のみで送信する)
APP_ENV=local
# セッション Cookie の署名鍵。本番では十分に長いランダム文字列にする
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me
APP_SESSION_MAX_AGE_DAYS=14

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ai_learning_portal
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=ai_learning_portal
# Azure Database for MySQL(TLS 必須)では CA 証明書を指定する
#   コンテナでは /etc/ssl/certs/ca-certificates.crt を指定すればよい
MYSQL_SSL_CA=

# ブラウザ内 Python(Pyodide)の配信元。自前配信に切り替える場合は URL(末尾 /)を変更する
PYODIDE_BASE_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/
